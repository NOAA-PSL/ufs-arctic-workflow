#!/bin/sh

# Used globally
export CDATE="${CDATE}"
export CDATEprior=$(date -d "${CDATE:0:8} ${CDATE:8:2} -1 day" +"%Y%m%d%H")
export NHRS=${NHRS} # Total number of forecast hours
export SACCT=${SACCT}
export FIX_DIR="/scratch4/BMC/ufs-artic/fix/"
export OCN_RES=${OCN_RES:ARC12}

export NLN="ln -sf"
export APRUNS="srun --nodes=1 --ntasks=1 --mem=16g --account=${SACCT} --exclusive"
export APRUNC="srun --nodes=1 --ntasks=6 --cpus-per-task=2 --account=${SACCT} --exclusive"

# Used by OCN
export OCN_SRC_GRID="mx025"
export OCN_SRC_GRID_DIR="${FIX_DIR}/gridfiles/${OCN_SRC_GRID}/"
export OCN_DST_GRID_DIR="${FIX_DIR}/gridfiles/${OCN_RES}/"
export OCN_SRC_DIR="${FIX_DIR}/inputs/GEFSv13-reforecasts/${CDATE}00/ics/ocn"
export OCN_SCRIPT_DIR="${TOP_DIR}/workflow/ocn"
export OCN_RUN_DIR="${PREP_DIR}/ocn"
export OCN_H_WGT_FILE="${OCN_SRC_GRID}.${OCN_RES}.h.nc"
export OCN_U_WGT_FILE="${OCN_SRC_GRID}.${OCN_RES}.u.nc"
export OCN_V_WGT_FILE="${OCN_SRC_GRID}.${OCN_RES}.v.nc"
export OCN_IC_FILE="mom6_IC.nc"
export OCN_OUT_FILE_PATH_BASE="mom6_OBC_"
export OCN_WGT_FILE_PATH_BASE="${OCN_SRC_GRID}.${OCN_RES}."
export OCN_ANG_FILE_PATH_BASE="ocean_hgrid_"
export OCN_HGD_FILE_PATH_BASE="ocean_hgrid_"
export OCN_FILE_TAIL=".nc"
export OCN_WGT_FILE_BASE="${OCN_SRC_GRID}.${OCN_RES}"
export OCN_SSH_VARNAME="sfc"
export OCN_SSH_SRC_FILE="MOM.res_1.nc"
export OCN_THK_VARNAME="h"
export OCN_THK_SRC_FILE="MOM.res.nc"
export OCN_TMP_VARNAME="Temp"
export OCN_TMP_SRC_FILE="MOM.res.nc"
export OCN_SAL_VARNAME="Salt"
export OCN_SAL_SRC_FILE="MOM.res.nc"
export OCN_U_VARNAME="u"
export OCN_U_SRC_FILE="MOM.res.nc"
export OCN_V_VARNAME="v"
export OCN_V_SRC_FILE="MOM.res_1.nc"
export OCN_SRC_ANG_NAME="angle_dx"
export OCN_SRC_ANG_FILE="${OCN_SRC_GRID}.ocean_hgrid.nc"
export OCN_SRC_CONVERT_ANG="True"
export OCN_DST_ANG_NAME="angle_dx"
export OCN_DST_ANG_FILE="ocean_hgrid.nc"
export OCN_DST_CONVERT_ANG="True"
export OCN_SRC_VRT_FILE="${OCN_SRC_GRID}.ocean_vgrid.nc"
export OCN_SRC_VRT_NAME="zt"
export OCN_DST_VRT_FILE="MOM.res.nc"
export OCN_DST_VRT_NAME="Layer"
export OCN_TIME_VARNAME="Time"

#export HAFSdir="/scratch4/BMC/ufs-artic/fix/hwrf/HAFS/"
#export FIXhafs="${HAFSdir}/fix"
#export PARMhafs="${HAFSdir}/parm"
#export EXEChafs="${HAFSdir}/exec"
#export USHhafs="${HAFSdir}/ush"
#export MODhafs="${HAFSdir}/modulefiles"
#export COMINrtofs="/scratch1/NCEPDEV/hwrf/noscrub/hafs-input/COMRTOFSv2"
#export COMINgfs="/scratch1/NCEPDEV/hwrf/noscrub/hafs-input/COMGFSv16"

# Used by ICE
export ICE_SRC_GRID="mx025"
export ICE_RES=${OCN_RES:ARC12}
export ICE_SRC_GRID_DIR="${FIX_DIR}/gridfiles/${ICE_SRC_GRID}/"
export ICE_DST_GRID_DIR="${FIX_DIR}/gridfiles/${ICE_RES}/"
export ICE_INPUT_DIR="${FIX_DIR}/inputs/GEFSv13-reforecasts/${CDATE}00/ics/ice"
export ICE_SCRIPT_DIR="${TOP_DIR}/workflow/ice"
export ICE_RUN_DIR="${PREP_DIR}/ice"
export ICE_SRC_FILE="Ct.${ICE_SRC_GRID}_SCRIP_masked.nc"
export ICE_DST_FILE="ocean_mask.nc"
export ICE_WGT_FILE="${ICE_SRC_GRID}.${ICE_RES}.h.nc"
export ICE_SRC_ANG_NAME="angle_dx"
export ICE_SRC_ANG_FILE="${ICE_SRC_GRID}.ocean_hgrid.nc"
export ICE_DST_ANG_NAME="angle_dx"
export ICE_DST_ANG_FILE="ocean_hgrid.nc"

# Used by ATM
export ATM_SCRIPT_DIR="${TOP_DIR}/workflow/atm"
export ATM_RUN_DIR="${PREP_DIR}/atm"
export ATM_RES=${ATM_RES:C185}
export ATM_DATA_DIR="${FIX_DIR}/inputs/GEFSv13-reforecasts/${CDATE}00"
export ATM_TILE=7
export ATM_LEVS=128
export ATM_REGIONAL=1
export ATM_HALO_BNDY=4
export ATM_HALO_BLEND=8
export ATM_SRC_CASE="C384"
export ATM_DST_CASE=${ATM_RES}
export SFC_ICTYPE="restart_files" 
export ATM_ICTYPE="grib_files" 
export ATM_BCTYPE="grib_files"
export ATM_NBDYINT=3 # Boundary input interval in hours
export ATM_DO_LSU="True" # Set 'True' to add Land spinup data to surface file
export UFSUTILS_DIR="${FIX_DIR}/exe/UFS_UTILS/"
export CHGRES_EXEC="$UFSUTILS_DIR/exec/chgres_cube"
